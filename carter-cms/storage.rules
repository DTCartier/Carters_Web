rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sites/{siteId}/media/{fileName} {
      function canEdit() {
        return request.auth != null && (
          request.auth.token.get('platformAdmin', false) == true ||
          firestore.get(/databases/(default)/documents/siteMembers/$(siteId)).data.roles.get(request.auth.uid, '') in ['owner', 'editor']
        );
      }
      allow read: if true;
      allow create, update: if canEdit()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canEdit();
    }
  }
}
